# Preferred: Levanto Sage (the parent repo .env is also read)
LEVANTO_SAGE_API_KEY=
# LEVANTO_SAGE_URL=https://sage.levanto.ai

# Fallback: OpenRouter (the parent repo .env is also read)
OPENROUTER_API_KEY=
# JEV_OPENROUTER_MODEL=google/gemini-2.5-flash
# Alternative: TypeSafe System One (Jev). Used only when no OpenRouter key is set.
TYPESAFE_API_KEY=
